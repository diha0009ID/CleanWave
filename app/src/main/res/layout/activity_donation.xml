<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Top Banner -->
            <ImageView
                android:id="@+id/headerBanner"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:scaleType="centerCrop"
                android:src="@drawable/donateandsupportbanner"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="Header" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Donation &amp; Support"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Main Logo Circle -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logoCard"
                android:layout_width="70dp"
                android:layout_height="70dp"
                app:cardCornerRadius="35dp"
                app:cardElevation="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/headerBanner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/headerBanner"
                app:layout_constraintVertical_bias="0.3">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@drawable/ico1" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/logoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Clean wave"
                android:textColor="#005DAA"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/logoCard" />

            <TextView
                android:id="@+id/supportTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="YOUR SUPPORT CAN MAKE A DIFFERENCE"
                android:textColor="#001F54"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/logoText" />

            <!-- Support Cards Grid -->
            <LinearLayout
                android:id="@+id/cardGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                app:layout_constraintTop_toBottomOf="@+id/supportTitle">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Card 1 (img1, ico1) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp">
                            <ImageView android:id="@+id/i1" android:layout_width="match_parent" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/img1" app:layout_constraintTop_toTopOf="parent"/>
                            <com.google.android.material.card.MaterialCardView android:id="@+id/ic1" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="8dp" app:cardCornerRadius="14dp" app:cardElevation="4dp" app:strokeColor="#005DAA" app:strokeWidth="1dp" app:layout_constraintBottom_toBottomOf="@+id/i1" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/i1"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:src="@drawable/ico1"/></com.google.android.material.card.MaterialCardView>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Cleaner Oceans" android:textColor="#001F54" android:textSize="9sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@+id/ic1" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/ic1" app:layout_constraintTop_toTopOf="@+id/ic1"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2 (img2, ico2) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp">
                            <ImageView android:id="@+id/i2" android:layout_width="match_parent" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/img2" app:layout_constraintTop_toTopOf="parent"/>
                            <com.google.android.material.card.MaterialCardView android:id="@+id/ic2" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="8dp" app:cardCornerRadius="14dp" app:cardElevation="4dp" app:strokeColor="#005DAA" app:strokeWidth="1dp" app:layout_constraintBottom_toBottomOf="@+id/i2" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/i2"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:src="@drawable/ico2"/></com.google.android.material.card.MaterialCardView>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Cleaner Oceans" android:textColor="#001F54" android:textSize="9sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@+id/ic2" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/ic2" app:layout_constraintTop_toTopOf="@+id/ic2"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 3 (img3, ico3) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp">
                            <ImageView android:id="@+id/i3" android:layout_width="match_parent" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/img3" app:layout_constraintTop_toTopOf="parent"/>
                            <com.google.android.material.card.MaterialCardView android:id="@+id/ic3" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="8dp" app:cardCornerRadius="14dp" app:cardElevation="4dp" app:strokeColor="#005DAA" app:strokeWidth="1dp" app:layout_constraintBottom_toBottomOf="@+id/i3" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/i3"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:src="@drawable/ico3"/></com.google.android.material.card.MaterialCardView>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Cleaner Oceans" android:textColor="#001F54" android:textSize="9sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@+id/ic3" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/ic3" app:layout_constraintTop_toTopOf="@+id/ic3"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Card 4 (img4, ico4) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp">
                            <ImageView android:id="@+id/i4" android:layout_width="match_parent" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/img4" app:layout_constraintTop_toTopOf="parent"/>
                            <com.google.android.material.card.MaterialCardView android:id="@+id/ic4" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="8dp" app:cardCornerRadius="14dp" app:cardElevation="4dp" app:strokeColor="#005DAA" app:strokeWidth="1dp" app:layout_constraintBottom_toBottomOf="@+id/i4" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/i4"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:src="@drawable/ico4"/></com.google.android.material.card.MaterialCardView>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Cleaner Oceans" android:textColor="#001F54" android:textSize="9sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@+id/ic4" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/ic4" app:layout_constraintTop_toTopOf="@+id/ic4"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 5 (img5, ico5) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp">
                            <ImageView android:id="@+id/i5" android:layout_width="match_parent" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/img5" app:layout_constraintTop_toTopOf="parent"/>
                            <com.google.android.material.card.MaterialCardView android:id="@+id/ic5" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="8dp" app:cardCornerRadius="14dp" app:cardElevation="4dp" app:strokeColor="#005DAA" app:strokeWidth="1dp" app:layout_constraintBottom_toBottomOf="@+id/i5" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/i5"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:src="@drawable/ico5"/></com.google.android.material.card.MaterialCardView>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Cleaner Oceans" android:textColor="#001F54" android:textSize="9sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@+id/ic5" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/ic5" app:layout_constraintTop_toTopOf="@+id/ic5"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 6 (img6, ico6) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeWidth="0dp">
                        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp">
                            <ImageView android:id="@+id/i6" android:layout_width="match_parent" android:layout_height="80dp" android:scaleType="centerCrop" android:src="@drawable/img6" app:layout_constraintTop_toTopOf="parent"/>
                            <com.google.android.material.card.MaterialCardView android:id="@+id/ic6" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="8dp" app:cardCornerRadius="14dp" app:cardElevation="4dp" app:strokeColor="#005DAA" app:strokeWidth="1dp" app:layout_constraintBottom_toBottomOf="@+id/i6" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/i6"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="5dp" android:src="@drawable/ico6"/></com.google.android.material.card.MaterialCardView>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Cleaner Oceans" android:textColor="#001F54" android:textSize="9sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@+id/ic6" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/ic6" app:layout_constraintTop_toTopOf="@+id/ic6"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Donation Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:baselineAligned="false"
                app:layout_constraintTop_toBottomOf="@+id/cardGrid">

                <!-- Left column (Info) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.45"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/hco1" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Lorem ipsum dolor sit amet..." android:textSize="10sp" android:textColor="#003366"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/hco2" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Lorem ipsum dolor sit amet..." android:textSize="10sp" android:textColor="#003366"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Right column (Donation) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.55" app:cardBackgroundColor="#005DAA" app:cardCornerRadius="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/hco3" app:tint="#28A745" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAKE A DONATION" android:textColor="@android:color/white" android:textStyle="bold" android:textSize="14sp" android:layout_marginTop="4dp"/>
                        <Button android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginTop="16dp" android:text="DONATE NOW" android:backgroundTint="#28A745" android:textColor="@android:color/white" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="unlabeled"/>

</androidx.constraintlayout.widget.ConstraintLayout>
